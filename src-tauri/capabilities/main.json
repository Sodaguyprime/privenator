{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the app's own commands plus event delivery. No core:default, so no window, path, menu, tray or resource APIs reach the webview.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "allow-app-info",
    "allow-vault-status",
    "allow-password-strength",
    "allow-create-vault",
    "allow-unlock",
    "allow-recover",
    "allow-change-password",
    "allow-regenerate-recovery-key",
    "allow-lock",
    "allow-activity",
    "allow-release-autolock",
    "allow-save-recovery-key",
    "allow-list-microphones",
    "allow-mic-test-start",
    "allow-mic-test-stop",
    "allow-start-recording",
    "allow-pause-recording",
    "allow-resume-recording",
    "allow-recording-status",
    "allow-stop-recording",
    "allow-save-recording",
    "allow-list-entries",
    "allow-get-entry",
    "allow-create-typed-entry",
    "allow-set-entry-title",
    "allow-set-entry-text",
    "allow-revert-entry",
    "allow-set-entry-mood",
    "allow-set-entry-tags",
    "allow-delete-entry",
    "allow-all-tags",
    "allow-entry-audio",
    "allow-search-entries",
    "allow-get-settings",
    "allow-update-settings",
    "allow-create-backup",
    "allow-restore-backup"
  ]
}
